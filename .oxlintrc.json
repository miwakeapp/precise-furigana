{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["data/", "dist/", "test/fixtures/"],
  "rules": {
    "unicorn/no-new-array": "off"
  },
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    }
  ]
}
