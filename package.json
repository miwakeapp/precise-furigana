{
  "name": "precise-furigana",
  "version": "1.0.0",
  "private": true,
  "description": "Evidence-based furigana alignment for every JMdict spelling and reading",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch-sources.ts",
    "build": "node --max-old-space-size=4096 scripts/build.ts",
    "validate": "node scripts/validate.ts",
    "inspect": "node --max-old-space-size=4096 scripts/inspect.ts",
    "compare": "node scripts/compare.ts",
    "test": "node --test \"test/*.test.ts\"",
    "check": "oxfmt --check && tsc",
    "fmt": "oxfmt"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@scriptin/jmdict-simplified-types": "^3.6.1",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.79.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
