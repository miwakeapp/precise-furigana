{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Precise Furigana database",
  "type": "object",
  "required": ["version", "schemaVersion", "jmdictDate", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "<schema version>.<JMdict date as YYYYMMDD>.<revision>, for example 1.20261116.0",
      "type": "string"
    },
    "schemaVersion": { "const": 1 },
    "jmdictDate": { "type": "string", "format": "date" },
    "entries": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "segment": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/text" }, { "$ref": "#/$defs/text" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "record": {
      "type": "object",
      "required": ["spelling", "reading", "segments"],
      "additionalProperties": false,
      "properties": {
        "spelling": { "$ref": "#/$defs/text" },
        "reading": { "$ref": "#/$defs/text" },
        "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" } },
        "pairing": { "enum": ["mispaired", "phonetic", "synthesized"] }
      }
    }
  }
}
