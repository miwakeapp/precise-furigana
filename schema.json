{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Precise furigana database, schema 2",
  "type": "object",
  "required": ["schemaVersion", "jmdictDate", "license", "attribution", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "jmdictDate": { "type": "string", "format": "date" },
    "license": { "const": "CC-BY-SA-4.0" },
    "attribution": { "$ref": "#/$defs/text" },
    "entries": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pair" } }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "segment": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/text" }, { "$ref": "#/$defs/text" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "pair": {
      "type": "object",
      "required": ["written", "reading", "segments"],
      "additionalProperties": false,
      "properties": {
        "written": { "$ref": "#/$defs/text" },
        "reading": { "$ref": "#/$defs/text" },
        "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" } }
      }
    }
  }
}
